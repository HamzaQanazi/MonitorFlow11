DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/monitorflow
JWT_SECRET=change-me-64-random-hex-chars
PORT=3000
# Bilingual auto-fill translation (CLAUDE.md §13, 2026-08-21 exception). Get a
# free key at https://aistudio.google.com/apikey — no card required.
GEMINI_API_KEY=

# Email delivery (CLAUDE.md §13, supervisor-directed exception) — new-employee
# credentials and password-reset links. Leave SMTP_HOST unset in dev: the
# mailer logs the message to the console instead of sending it. For a real
# Gmail account: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Gmail App Password, not your normal password>.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Origin the web console is served from — used to build the link inside
# password-reset emails (POST /auth/forgot-password).
WEB_BASE_URL=http://localhost:5173

